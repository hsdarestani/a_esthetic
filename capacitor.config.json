{
  "appId": "de.aplusesthetic.app",
  "appName": "A+ Esthetic",
  "webDir": "www",
  "loggingBehavior": "none",
  "backgroundColor": "#F6F3EC",
  "zoomEnabled": false,
  "server": {
    "allowNavigation": [
      "book.a-esthetic.de",
      "esthetic.smarbiz.sbs"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#F6F3EC"
  },
  "ios": {
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "webContentsDebuggingEnabled": false,
    "contentInset": "automatic",
    "backgroundColor": "#F6F3EC"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
